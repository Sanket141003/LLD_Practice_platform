PORT=5000
MONGODB_URI=mongodb://localhost:27017/lld-practice

# AI Provider: 'gemini' (free) or 'openai' (paid)
AI_PROVIDER=gemini

# Google Gemini — FREE tier
# Get your auth key at: https://aistudio.google.com/app/apikey
# New keys start with AQ.Ab... (auth key format, default since Sep 2026)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# OpenAI — paid, leave blank if using Gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

CLIENT_URL=http://localhost:5173
NODE_ENV=development
DEMO_MODE=false
